DATABASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_REASONING_EFFORT=low
# raise it (e.g. 180) for reasoning models
OPENROUTER_TIMEOUT_SECONDS=60
SESSION_SECRET=
GCP_PROJECT_ID=
GCP_REGION=
UI_DEFAULT_LANG=
ENV=
# Operator scripts only: a fragment of the production host name (scripts/_prod_guard.py). Put
# the real value in your local .env, never in a tracked file. Empty refuses every non-local
# database in those scripts; the app does not read it.
PROD_DB_HOST_FRAGMENT=
